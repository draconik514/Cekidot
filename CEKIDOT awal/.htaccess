# ============================================================
# HTACCESS - CEKIDOT (SAFE VERSION - TANPA ERROR)
# Domain: www.cekidot.dispar.my.id
# ============================================================

RewriteEngine On

# ============================================================
# CEGAH DIRECTORY LISTING
# ============================================================
Options -Indexes

# ============================================================
# REDIRECT NON-WWW KE WWW
# ============================================================
RewriteCond %{HTTP_HOST} ^cekidot\.dispar\.my\.id [NC]
RewriteRule ^(.*)$ https://www.cekidot.dispar.my.id/$1 [R=301,L]

# ============================================================
# FILE SENSITIF - PROTEKSI
# ============================================================
<FilesMatch "^(config|database|security|functions)\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

<FilesMatch "\.(sql|log|ini|json|env|bak|backup)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

<FilesMatch "^\.(htaccess|htpasswd)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ============================================================
# CEGAH AKSES FOLDER CONFIG
# ============================================================
RewriteRule ^config/ - [F,L]

# ============================================================
# BROWSER CACHE
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ============================================================
# GZIP COMPRESSION - (DIKOMENTAR DULU UNTUK CEK)
# ============================================================
# <IfModule mod_deflate.c>
#     AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript
# </IfModule>

# ============================================================
# CEGAH HOTLINKING
# ============================================================
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?cekidot\.dispar\.my\.id [NC]
RewriteRule \.(jpg|jpeg|png|gif|svg|webp|ico|pdf)$ - [F,L]

# ============================================================
# CEGAH SQL INJECTION
# ============================================================
RewriteCond %{QUERY_STRING} (\<|%3C).*script.*(\>|%3E) [NC,OR]
RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%[0-9A-Z]{0,2}) [OR]
RewriteCond %{QUERY_STRING} _REQUEST(=|\[|\%[0-9A-Z]{0,2}) [OR]
RewriteCond %{QUERY_STRING} (select|insert|update|delete|drop|alter|create|truncate) [NC]
RewriteRule ^(.*)$ - [F,L]

# ============================================================
# CEGAH USER-AGENT BERBAHAYA
# ============================================================
RewriteCond %{HTTP_USER_AGENT} (libwww-perl|curl|wget|python|nikto|scan) [NC]
RewriteRule ^(.*)$ - [F,L]

# ============================================================
# CEGAH AKSES FILE TERSEMBUNYI
# ============================================================
RedirectMatch 404 /\..*$

# ============================================================
# ERROR DOCUMENT
# ============================================================
ErrorDocument 404 /404.php
ErrorDocument 403 /403.php

# ============================================================
# PHP CONFIGURATION - TANPA OPcache
# ============================================================
<IfModule php_module>
    php_value error_log "/home/dism4551/logs/php.error.log"
    php_flag log_errors On
    php_flag display_errors Off
    php_flag display_startup_errors Off
    php_value memory_limit 256M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value upload_max_filesize 20M
    php_value post_max_size 20M
</IfModule>

<IfModule lsapi_module>
    php_value error_log "/home/dism4551/logs/php.error.log"
    php_flag log_errors On
    php_flag display_errors Off
    php_flag display_startup_errors Off
    php_value memory_limit 256M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value upload_max_filesize 20M
    php_value post_max_size 20M
</IfModule>

# ============================================================
# KEEP ALIVE
# ============================================================
<IfModule mod_keepalive.c>
    KeepAlive On
    MaxKeepAliveRequests 100
    KeepAliveTimeout 5
</IfModule>

# ============================================================
# HEADER KEAMANAN (PAKAI IFMODULE)
# ============================================================
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# ============================================================
# KHUSUS UNTUK FILE PDF - IZINKAN IFRAME
# ============================================================
<FilesMatch "\.(pdf)$">
    Header set X-Frame-Options "SAMEORIGIN"
</FilesMatch>  